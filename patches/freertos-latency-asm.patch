--- portASM.S
+++ portASM.S
@@ -224,7 +224,7 @@
 
 /*-----------------------------------------------------------*/
 
-   .macro restoreallgpregisters
+   .macro restoreallgpregisters startup=0
 /* Restore all general-purpose registers from stack. */
 LDP X30, XZR, [ SP ], # 0x10
 LDP X28, X29, [ SP ], # 0x10
@@ -241,6 +241,23 @@
 LDP X6, X7, [ SP ], # 0x10
 LDP X4, X5, [ SP ], # 0x10
 LDP X2, X3, [ SP ], # 0x10
+#ifdef SUNSTONE_SCHED_LATENCY_TRACE
+   .if \startup
+   /* Only the first task restore records this boundary. X0/X1 remain saved;
+    * no C call may clobber the registers already restored above. */
+   MRS X0, TPIDR_EL1
+   AND X0, X0, #0xff
+   ADRP X1, ss_sched_trace_startup_markers
+   ADD X1, X1, :lo12:ss_sched_trace_startup_markers
+   ADD X0, X1, X0, LSL #4
+   LDR X1, [X0, #8]
+   CBNZ X1, 98f
+   ISB
+   MRS X1, CNTVCT_EL0
+   STR X1, [X0, #8]
+98:
+   .endif
+#endif
 LDP X0, X1, [ SP ], # 0x10
    .endm
 
@@ -526,6 +543,20 @@
    MOV X1, # portMAX_API_PRIORITY_MASK
 
 4:
+#ifdef SUNSTONE_LATENCY
+   /* A context restore can unmask without a C portENABLE_INTERRUPTS call.
+    * Close the old core interval while IRQ entry still excludes writers.
+    * X0-X3 remain live; the task's remaining GP/FPU state is still saved. */
+   CBNZ X3, 9f
+   STP X0, X1, [ SP, #-16 ]!
+   STP X2, X3, [ SP, #-16 ]!
+   MRS X0, TPIDR_EL1
+   ADR X1, 9f
+   BL ss_latency_mask_close
+   LDP X2, X3, [ SP ], #16
+   LDP X0, X1, [ SP ], #16
+9:
+#endif
    MSR ICC_PMR_EL1, X1      /* Set interrupt mask */
    DSB SY
    ISB SY
@@ -564,7 +595,7 @@
       ORR  X0, X0, X2, LSL # 56
       MSR  TPIDRRO_EL0, X0
    #endif
-   restoreallgpregisters
+   restoreallgpregisters 1
 
 #if ( configENABLE_MPU == 1 )
    /* Save pxTopOfStack ( ullContext ) on the task's TCB and set SP_EL0 to ullTaskUnprivilegedSP. */
