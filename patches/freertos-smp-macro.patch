+/* State that only its own core writes, one 64-byte line per core.
+ * ullTaskHasFPUContext is saved as part of the task context: when it is
+ * non-zero the floating point context is saved and restored for the task.
+ * ullOwnedLocks has bit eLockNum set while the core holds that lock.
+ * ullOpenMask holds, XOR 0xff, the value the core writes to ICC_PMR_EL1
+ * when a task-level path leaves the API mask: the mask of its running task's
+ * band (interrupt-level restores write their saved value, port.c). A
+ * zero word opens every priority (0xff), so a kernel that sets no band keeps
+ * the port's original behaviour. The core writes its own word with the API
+ * mask held (portSET_OPEN_MASK); portASM.S reads it at portOPEN_MASK_OFFSET. */
+    #define portOPEN_MASK_OFFSET    16
+    #if !defined(__ASSEMBLER__)
+        typedef struct PortCoreState
+        {
+            uint64_t ullTaskHasFPUContext;
+            volatile uint64_t ullOwnedLocks;
+            volatile uint64_t ullOpenMask;
+        } __attribute__( ( aligned( 64 ) ) ) PortCoreState_t;
+        extern PortCoreState_t xPortCoreStates[];
+
+        /* EL1 only: the mask this core opens to. */
+        static inline __attribute__( ( always_inline ) ) uint64_t ullPortOpenMask( void )
+        {
+            uint64_t ullCore;
+
+            __asm volatile ( "MRS %0, tpidr_el1" : "=r" ( ullCore ) );
+            return xPortCoreStates[ ullCore & 0xffU ].ullOpenMask ^ 0xffU;
+        }
+        #define portOPEN_MASK()    ullPortOpenMask()
+        /* EL1, on core ulCore, with the API mask held. */
+        #define portSET_OPEN_MASK( ulCore, ulMask ) \
+    ( xPortCoreStates[ ( ulCore ) ].ullOpenMask = ( ( uint64_t ) ( ulMask ) ^ 0xffU ) )
+    #endif /* if !defined(__ASSEMBLER__) */
+#endif /* if ( configNUMBER_OF_CORES > 1 ) */
