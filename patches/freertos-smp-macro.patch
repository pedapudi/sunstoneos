+        static inline uint64_t ullPortGetTaskRegister( void )
+        {
+            uint64_t ullValue;
+
+            __asm volatile ( "MRS %0, TPIDRRO_EL0" : "=r" ( ullValue ) );
+            return ullValue;
+        }
+
+        /* Records the task selected for this core; called at EL1 only. */
+        #define portSET_CURRENT_TASK( xCoreID, pxTCB )                                             \
+    __asm volatile ( "MSR TPIDRRO_EL0, %0" ::"r" ( ( uint64_t ) ( uintptr_t ) ( pxTCB ) |          \
+                                                  ( ( uint64_t ) ( xCoreID ) << portTASK_REGISTER_CORE_SHIFT ) | \
+                                                  ( 1ULL << portTASK_REGISTER_EL1_BIT ) ) : "memory" )
     #endif /* if !defined(__ASSEMBLER__) */
 
