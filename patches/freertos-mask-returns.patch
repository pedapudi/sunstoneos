  * FreeRTOS_SWI_Handler handler is used to perform a context switch.
  *****************************************************************************/
    .align 8
+#ifdef SUNSTONE_LATENCY_RESTORE_SPANS
+/* Preserve restored volatile state around the last C timestamp. The final
+ * temporary GP restore and ERET remain an unmeasured instrumentation tail. */
+.macro ss_latency_return_point
+savefuncontextgpregs
+MRS X0, TPIDR_EL1
+AND X0, X0, #0xff
+MRS X1, SPSR_EL1
+MRS X2, ICC_PMR_EL1
+BL ss_latency_exception_return
+#ifdef SUNSTONE_SCHED_LATENCY_TRACE
+/* Include the first return observer in startup only after portRESTORE_CONTEXT
+ * has supplied its marker. Early bootstrap SVC returns leave the guard clear.
+ * All scratch registers remain in the temporary frame above. */
+MRS X0, TPIDR_EL1
+AND X0, X0, #0xff
+ADRP X1, ss_latency_first_return_seen
+ADD X1, X1, :lo12:ss_latency_first_return_seen
+LDR X2, [X1, X0, LSL #3]
+CBNZ X2, 97f
+ADRP X2, ss_sched_trace_startup_markers
+ADD X2, X2, :lo12:ss_sched_trace_startup_markers
+ADD X2, X2, X0, LSL #4
+LDR X3, [X2, #8]
+CBZ X3, 97f
+MOV X3, #1
+STR X3, [X1, X0, LSL #3]
+ISB
+MRS X3, CNTVCT_EL0
+STR X3, [X2, #8]
+97:
+#endif
+restorefuncontextgpregs
+.endm
+#endif
+
    .type FreeRTOS_SWI_Handler, % function
 FreeRTOS_SWI_Handler:
 /* Save X0-X5 temporarily as they are used in the handler. */
 STP X0, X1, [SP, #-0x10]!
 STP X2, X3, [SP, #-0x10]!
 STP X4, X5, [SP, #-0x10]!
+#ifdef SUNSTONE_LATENCY_RESTORE_SPANS
+savefuncontextgpregs
+MRS X0, TPIDR_EL1
+AND X0, X0, #0xff
+BL ss_latency_exception_enter
+restorefuncontextgpregs
+#endif
 #ifdef SUNSTONE_SCHED_LATENCY_TRACE
 /* This selection originates in SVC, regardless of the last completed IRQ.
  * X0/X1 are saved above and DAIF.I excludes an interrupt-side tag update. */
 ADRP X0, ss_sched_trace_switch_irq
 ADD X0, X0, :lo12:ss_sched_trace_switch_irq
 MRS X1, TPIDR_EL1
 AND X1, X1, #0xff
 STR XZR, [X0, X1, LSL #3]
 #endif
 
 MRS X4, ELR_EL1  /* Save exception return address. */
 MRS X5, SPSR_EL1 /* Save program status register address. */
@@ -661,6 +704,9 @@
 LDP X0, X1, [SP], #0x10
 DSB SY
 ISB SY
+#ifdef SUNSTONE_LATENCY_RESTORE_SPANS
+ss_latency_return_point
+#endif
 ERET
 
