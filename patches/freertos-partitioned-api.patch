+TickType_t tick = (TickType_t)now;
+TickType_t elapsed = tick - pxTimeOut->xTimeOnEntering;
+BaseType_t overflow = (sizeof(TickType_t) == sizeof(uint64_t) ? 0 : (BaseType_t)(now >> ((sizeof(TickType_t) * 8) % 64)));
+BaseType_t result;
+#if ( INCLUDE_xTaskAbortDelay == 1 )
+if (pxCurrentTCBs[ssKernelCPUId()]->ucDelayAborted) {
+    pxCurrentTCBs[ssKernelCPUId()]->ucDelayAborted = pdFALSE;
+    result = pdTRUE;
+} else
+#endif
+#if ( INCLUDE_vTaskSuspend == 1 )
+if (*pxTicksToWait == portMAX_DELAY) result = pdFALSE;
+else
+#endif
+if ((overflow != pxTimeOut->xOverflowCount && tick >= pxTimeOut->xTimeOnEntering) || elapsed >= *pxTicksToWait) {
+    *pxTicksToWait = 0;
+    result = pdTRUE;
+} else {
+    *pxTicksToWait -= elapsed;
+    pxTimeOut->xOverflowCount = overflow;
+    pxTimeOut->xTimeOnEntering = tick;
+    result = pdFALSE;
+}
+portCLEAR_INTERRUPT_MASK(irq);
