+  // Observe current self power before changing downstream power controls.
+  const tusb_control_request_t request = {
+    .bmRequestType = 0x80, .bRequest = TUSB_REQ_GET_STATUS, .wLength = 2
+  };
+  xfer->setup = &request;
+  xfer->buffer = p_epbuf->ctrl_buf;
+  xfer->complete_cb = config_device_power;
+  TU_ASSERT(tuh_control_xfer(xfer), );
+}
+
+static void config_device_power(tuh_xfer_t* xfer) {
+  TU_ASSERT(XFER_RESULT_SUCCESS == xfer->result, );
+  const tusb_control_request_t request = {
+    .bmRequestType = 0xa0, .bRequest = HUB_REQUEST_GET_STATUS, .wLength = 4
+  };
+  xfer->setup = &request;
+  xfer->complete_cb = config_hub_power;
+  TU_ASSERT(tuh_control_xfer(xfer), );
+}
+
+static void config_hub_power(tuh_xfer_t* xfer) {
+  TU_ASSERT(XFER_RESULT_SUCCESS == xfer->result, );
+  // The HCD validates both power responses before either callback runs.
+  hub_port_set_feature(xfer->daddr, 1, HUB_FEATURE_PORT_POWER, config_port_power_complete, 0);
 }
 
