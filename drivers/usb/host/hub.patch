+static void config_ss_power(tuh_xfer_t* xfer);
+static void config_ss_depth(tuh_xfer_t* xfer);
+static void config_port_start(uint8_t daddr,uint8_t port);
 static void config_port_power_complete (tuh_xfer_t* xfer);
