@@ -279,9 +285,9 @@
       .direction = TUSB_DIR_IN
     },
     .bRequest = HUB_REQUEST_GET_DESCRIPTOR,
-    .wValue   = 0,
+    .wValue   = tuh_speed_get(xfer->daddr)==TUSB_SPEED_SUPER?0x2a00:0x2900,
     .wIndex   = 0,
-    .wLength  = sizeof(hub_desc_cs_t)
+    .wLength  = tuh_speed_get(xfer->daddr)==TUSB_SPEED_SUPER?12:sizeof(hub_desc_cs_t)
