@@ -305,9 +311,52 @@
 
   // May need to GET_STATUS
 
-  // Set Port Power to be able to detect connection, starting with port 1
-  uint8_t const hub_port = 1;
-  hub_port_set_feature(daddr, hub_port, HUB_FEATURE_PORT_POWER, config_port_power_complete, 0);
+  // Observe current self power before changing downstream power controls.
+  const tusb_control_request_t request = {
+    .bmRequestType = 0x80, .bRequest = TUSB_REQ_GET_STATUS, .wLength = 2
+  };
+  xfer->setup = &request;
+  xfer->buffer = p_epbuf->ctrl_buf;
+  xfer->complete_cb = config_device_power;
+  TU_ASSERT(tuh_control_xfer(xfer), );
+}
+
+static void config_device_power(tuh_xfer_t* xfer) {
+  TU_ASSERT(XFER_RESULT_SUCCESS == xfer->result, );
+  const tusb_control_request_t request = {
+    .bmRequestType = 0xa0, .bRequest = HUB_REQUEST_GET_STATUS, .wLength = 4
+  };
+  xfer->setup = &request;
+  xfer->complete_cb = config_hub_power;
+  TU_ASSERT(tuh_control_xfer(xfer), );
+}
+
+static void config_hub_power(tuh_xfer_t* xfer) {
+  TU_ASSERT(XFER_RESULT_SUCCESS == xfer->result, );
+  // The HCD validates both power responses before either callback runs.
+  if(tuh_speed_get(xfer->daddr)==TUSB_SPEED_SUPER){
+    const tusb_control_request_t request={.bmRequestType=0x20,.bRequest=12};
+    xfer->setup=&request;xfer->buffer=NULL;xfer->complete_cb=config_ss_depth;
+    TU_ASSERT(tuh_control_xfer(xfer),);
+  }else config_port_start(xfer->daddr,1);
+}
+
+static void config_port_start(uint8_t daddr,uint8_t port) {
+  if(tuh_speed_get(daddr)==TUSB_SPEED_SUPER)
+    hub_port_set_feature(daddr,port,23,config_ss_u2,0);
+  else hub_port_set_feature(daddr,port,HUB_FEATURE_PORT_POWER,config_port_power_complete,0);
+}
+static void config_ss_depth(tuh_xfer_t* xfer) {
+  TU_ASSERT(xfer->result==XFER_RESULT_SUCCESS,);
+  config_port_start(xfer->daddr,1);
+}
+static void config_ss_u2(tuh_xfer_t* xfer) {
+  TU_ASSERT(xfer->result==XFER_RESULT_SUCCESS,);
+  hub_port_set_feature(xfer->daddr,(uint8_t)xfer->setup->wIndex,24,config_ss_power,0);
+}
+static void config_ss_power(tuh_xfer_t* xfer) {
+  TU_ASSERT(xfer->result==XFER_RESULT_SUCCESS,);
+  hub_port_set_feature(xfer->daddr,(uint8_t)xfer->setup->wIndex,HUB_FEATURE_PORT_POWER,config_port_power_complete,0);
 }
 
 static void config_port_power_complete (tuh_xfer_t* xfer) {
