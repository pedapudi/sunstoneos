  "object_validation": "Real queue empty-receive retry, event wait/set/clear, stream wait/send and timer command enqueue with explicit host owner checkpoints; no concurrent stacks or timer callback execution.",
  "critical_scope": "Public task critical sections retain compatibility task/ISR locks, local IRQ masking and local preemption exclusion. Public ISR critical sections retain the ISR lock and local exclusion. Other owner schedulers continue dispatching; global scheduler suspension remains a separate gate.",
  "unsupported_api_contracts": {
    "vTaskEndScheduler": "Routes directly to vPortEndScheduler. The pinned upstream ARM_CR82 port explicitly asserts because scheduler stop is unsupported; it does not run legacy idle-task deletion. A linked subprocess verifies the unsupported port entry is reached with idle/timer tasks intact."
  },
  "excluded_optional_configurations": {
    "configSUPPORT_DYNAMIC_ALLOCATION": 1,
    "portUSING_MPU_WRAPPERS": "nonzero",
    "configUSE_TICKLESS_IDLE": "nonzero; series D",
    "configUSE_STATS_FORMATTING_FUNCTIONS": "positive"
  },
  "placement_validation": "A host checkpoint fixture records one observation of ready work waiting on its busy owner beside an idle core. This confirms no idle pull in series B; it is not a concurrent imbalance measurement."
}
