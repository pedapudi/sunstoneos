# Private standalone DSI application; inherited boot CPU/SRE path and providers.
set(dsi_app "${SUNSTONE_SOURCE_ROOT}/apps/dsi-scanout")
set(dsi_build "${CMAKE_CURRENT_BINARY_DIR}/dsi-scanout")
file(MAKE_DIRECTORY "${dsi_build}")
get_target_property(dsi_sources sunstone-a733-board-single-core SOURCES)
list(FILTER dsi_sources EXCLUDE REGEX "(/board-single-core/(session|admission|build-id)\\.c$|/apps/board/usb0\\.c$|/apps/storage-read-single-core/(monitor|runtime)\\.c$)")
# Drop the target object expression; retain it once below.
list(REMOVE_ITEM dsi_sources "$<TARGET_OBJECTS:a733-board-usb2-host>")
apply_build_patch("${dsi_build}/monitor.c" "${SUNSTONE_SOURCE_ROOT}/apps/storage-read-single-core/monitor.c" "${dsi_app}/monitor.patch")
apply_build_patch("${dsi_build}/runtime.c" "${SUNSTONE_SOURCE_ROOT}/apps/storage-read-single-core/runtime.c" "${dsi_app}/runtime.patch")
apply_build_patch("${dsi_build}/link.ld" "${SUNSTONE_SOURCE_ROOT}/apps/board-single-core/link.ld" "${dsi_app}/link.patch")
# Reuse the actual patched prefix validator, without its ordinary contract entry.
get_target_property(dsi_parent_sources sunstone-a733-board-single-core SOURCES)
foreach(source IN LISTS dsi_parent_sources)
 if(source MATCHES "/board-single-core/admission\\.c$")
  configure_file("${source}" "${dsi_build}/prefix-admission.inc" COPYONLY)
 endif()
endforeach()
list(APPEND dsi_sources "${dsi_build}/monitor.c" "${dsi_build}/runtime.c")
foreach(source main native profile session admission usb0)
 list(APPEND dsi_sources "${dsi_app}/${source}.c")
endforeach()
list(APPEND dsi_sources "${SUNSTONE_SOURCE_ROOT}/platform/a733/device_memory_layout.c"
 "${SUNSTONE_SOURCE_ROOT}/drivers/clock/a733_media_clock_native.c")
add_executable(sunstone-a733-dsi-scanout EXCLUDE_FROM_ALL ${dsi_sources} $<TARGET_OBJECTS:a733-board-usb2-host>)
include("${SUNSTONE_SOURCE_ROOT}/cmake/a733-dsi-native.cmake")
sunstone_a733_dsi_native(sunstone-a733-dsi-scanout)
foreach(property COMPILE_OPTIONS INCLUDE_DIRECTORIES LINK_LIBRARIES)
 get_target_property(value sunstone-a733-board-single-core ${property})
 if(value)
  set_property(TARGET sunstone-a733-dsi-scanout PROPERTY ${property} "${value}")
 endif()
endforeach()
sunstone_enable_radio_security(sunstone-a733-dsi-scanout "${SUNSTONE_RSN_DIR}")
get_target_property(dsi_definitions sunstone-a733-board-single-core COMPILE_DEFINITIONS)
list(FILTER dsi_definitions EXCLUDE REGEX "^A733_SMP_(CONTRACT|RESULT)_MAGIC=")
target_compile_definitions(sunstone-a733-dsi-scanout PRIVATE ${dsi_definitions}
 SUNSTONE_BOARD_APPLICATION=1 SUNSTONE_DSI_APPLICATION=1 SUNSTONE_A733_EXTENDED_DEVICE_MEMORY=1
 A733_SMP_CONTRACT_MAGIC=0x4153373344534331ULL A733_SMP_RESULT_MAGIC=0x4153373344535231ULL)
target_include_directories(sunstone-a733-dsi-scanout BEFORE PRIVATE "${dsi_app}" "${dsi_build}")
set(dsi_boot_units "${dsi_build}/monitor.c" "${dsi_build}/runtime.c")
foreach(source IN LISTS dsi_sources)
 if(source MATCHES "/board-single-core/platform\\.c$")
  list(APPEND dsi_boot_units "${source}")
 endif()
endforeach()
set_source_files_properties(${dsi_boot_units} TARGET_DIRECTORY sunstone-a733-dsi-scanout
 PROPERTIES COMPILE_OPTIONS "-include;${dsi_app}/boot.h")
file(GLOB dsi_headers "${dsi_app}/*.h")
get_target_property(dsi_inputs sunstone-a733-dsi-scanout SOURCES)
list(REMOVE_ITEM dsi_inputs "$<TARGET_OBJECTS:a733-board-usb2-host>")
list(APPEND dsi_inputs ${dsi_headers} "${dsi_app}/link.patch" "${dsi_app}/monitor.patch" "${dsi_app}/runtime.patch"
 "${CMAKE_CURRENT_LIST_FILE}" "${SUNSTONE_SOURCE_ROOT}/cmake/a733-dsi-native.cmake")
set(dsi_identity "dsi-single-core-v1;extended784MiB;retained;${dsi_definitions};${CMAKE_C_COMPILER_VERSION}")
foreach(source IN LISTS dsi_inputs)
 file(SHA256 "${source}" hash)
 string(APPEND dsi_identity "${hash}")
endforeach()
string(SHA256 dsi_build_id "${dsi_identity}")
string(REGEX REPLACE "(..)" "0x\\1," dsi_id_bytes "${dsi_build_id}")
file(WRITE "${dsi_build}/build-id.c" "const unsigned char a733_smp_build_id[32]={${dsi_id_bytes}};\n")
file(WRITE "${dsi_build}/build-id.txt" "${dsi_build_id}\n")
target_sources(sunstone-a733-dsi-scanout PRIVATE "${dsi_build}/build-id.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${dsi_inputs})
target_link_options(sunstone-a733-dsi-scanout PRIVATE -nostdlib -static -Wl,--gc-sections
 "-Wl,-T,${dsi_build}/link.ld" "-Wl,-Map,${dsi_build}/image.map")
set_target_properties(sunstone-a733-dsi-scanout PROPERTIES SUFFIX ".elf" LINK_DEPENDS "${dsi_build}/link.ld")
