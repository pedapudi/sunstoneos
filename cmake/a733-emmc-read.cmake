# Reuse the single-core kernel, read service, copied clients and native providers.
get_target_property(emmc_sources sunstone-a733-storage-read-single-core SOURCES)
list(FILTER emmc_sources EXCLUDE REGEX "/storage-read-single-core/build-id\\.c$")
set(emmc_build "${CMAKE_CURRENT_BINARY_DIR}/emmc-read")
file(MAKE_DIRECTORY "${emmc_build}")
add_executable(sunstone-a733-emmc-read EXCLUDE_FROM_ALL ${emmc_sources})
foreach(property COMPILE_OPTIONS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS LINK_LIBRARIES LINK_OPTIONS)
 get_target_property(value sunstone-a733-storage-read-single-core ${property})
 if(value)
  set_property(TARGET sunstone-a733-emmc-read PROPERTY ${property} "${value}")
 endif()
endforeach()
# The reused host object has no session-dependent ABI; inactive workload 2 code
# is collected by the linker. Every session consumer is compiled in this target.
get_target_property(emmc_defs sunstone-a733-emmc-read COMPILE_DEFINITIONS)
list(FILTER emmc_defs EXCLUDE REGEX "^A733_SMP_(CONTRACT|RESULT)_MAGIC=")
set_property(TARGET sunstone-a733-emmc-read PROPERTY COMPILE_DEFINITIONS "${emmc_defs}")
target_compile_definitions(sunstone-a733-emmc-read PRIVATE SUNSTONE_EMMC_READ=1
 A733_SMP_CONTRACT_MAGIC=0x4153373345524331ULL A733_SMP_RESULT_MAGIC=0x4153373352445231ULL)
set(emmc_inputs ${sdsc_inputs} "${CMAKE_CURRENT_LIST_FILE}" "${SUNSTONE_SOURCE_ROOT}/apps/emmc-read/CMakeLists.txt")
set(emmc_identity "emmc-read;explicit-controller;single-boot-cpu;retained;${CMAKE_C_COMPILER_VERSION}")
foreach(input IN LISTS emmc_inputs)
 file(SHA256 "${input}" emmc_hash)
 string(APPEND emmc_identity "${emmc_hash}")
endforeach()
string(SHA256 emmc_id "${emmc_identity}")
string(REGEX REPLACE "(..)" "0x\\1," emmc_bytes "${emmc_id}")
file(WRITE "${emmc_build}/build-id.c.tmp" "const unsigned char a733_smp_build_id[32]={${emmc_bytes}};\n")
configure_file("${emmc_build}/build-id.c.tmp" "${emmc_build}/build-id.c" COPYONLY)
file(WRITE "${emmc_build}/build-id.txt" "${emmc_id}\n")
target_sources(sunstone-a733-emmc-read PRIVATE "${emmc_build}/build-id.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${emmc_inputs})
set_target_properties(sunstone-a733-emmc-read PROPERTIES SUFFIX ".elf" LINK_DEPENDS "${sdsc_app}/link.ld")
