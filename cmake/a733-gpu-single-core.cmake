# One trusted compute client; reuse the storage adapter's retained single-core startup.
set(gpsc_root "${SUNSTONE_SOURCE_ROOT}")
set(gpsc_app "${gpsc_root}/apps/gpu-render-single-core")
set(gpsc_shared "${gpsc_root}/apps/storage-read-single-core")
set(gpsc_build "${CMAKE_CURRENT_BINARY_DIR}/gpu-single-core")
set(gpsc_port "${FREERTOS_DIR}/portable/GCC/ARM_AARCH64_SRE")
option(SUNSTONE_GPU_LIFECYCLE "Allow exclusive standalone GPU child disposal and reconstruction" OFF)
option(SUNSTONE_GPU_RUNTIME_INPUT "Accept copied runtime input within a sealed GPU program session" OFF)
option(SUNSTONE_GPU_PROGRAM_APPLICATION "Accept a sealed trusted compiled-program session" OFF)
option(SUNSTONE_GPU_TRANSPORT_ONLY "Observe the native shared USB transport without GPU construction or OPEN" OFF)
option(SUNSTONE_GPU_FINITE_RETURN "Return after two fixed GPU arithmetic jobs and verified shutdown" OFF)
if(SUNSTONE_GPU_FINITE_RETURN AND (NOT SUNSTONE_GPU_SUPERVISED OR NOT SUNSTONE_GPU_COMPUTE_APPLICATION OR
    SUNSTONE_GPU_PROGRAM_APPLICATION OR SUNSTONE_GPU_RUNTIME_INPUT OR SUNSTONE_GPU_RUNTIME_DRAW OR
    SUNSTONE_GPU_RUNTIME_TEXTURE OR SUNSTONE_GPU_LIFECYCLE OR SUNSTONE_GPU_TRANSPORT_ONLY))
  message(FATAL_ERROR "Finite GPU return requires the supervised fixed-arithmetic profile only")
endif()
file(MAKE_DIRECTORY "${gpsc_build}")
get_target_property(gpsc_sources sunstone-a733-gpu-render SOURCES)
list(FILTER gpsc_sources EXCLUDE REGEX "(/platform/a733-smp-|/platform/a733/cpu_|/freertos-a733-smp-cached/|/storage-maintenance/(boot|platform|continue|port|build-id)\\.|/gpu-application/(boot[^/]*|platform|build-id)\\.)")
# The SMP base links its patched tasks.c from the port directory, which the
# filter removes; a boot-CPU-only image links the kernel's own tasks.c.
list(APPEND gpsc_sources "${FREERTOS_DIR}/tasks.c")
list(APPEND gpsc_sources "${gpsc_root}/platform/a733/cpu_coherence.c"
 "${gpsc_root}/platform/a733/cpu_coherence.S" "${gpsc_root}/platform/a733/cpu_start.c"
 "${gpsc_root}/platform/a733-smp-cached/memory.c")
apply_build_patch("${gpsc_build}/port.c" "${gpsc_port}/port.c" "${gpsc_root}/patches/freertos-aarch64-clang.patch")
apply_build_patch("${gpsc_build}/platform.c" "${gpsc_root}/platform/a733/platform.c" "${gpsc_shared}/platform.patch")
apply_build_patch("${gpsc_build}/link.ld" "${gpsc_shared}/link.ld" "${gpsc_app}/link.patch")
list(APPEND gpsc_sources "${gpsc_shared}/start.S" "${gpsc_shared}/monitor.c" "${gpsc_shared}/runtime.c"
 "${gpsc_build}/platform.c" "${gpsc_build}/port.c" "${gpsc_port}/portASM.S"
 "${gpsc_root}/arch/aarch64/start.S" "${gpsc_root}/arch/aarch64/vectors.S" "${gpsc_root}/arch/aarch64/cache.S")
set(gpsc_link "${gpsc_build}/link.ld")
if(SUNSTONE_GPU_FINITE_RETURN)
  apply_build_patch("${gpsc_build}/return-monitor.c" "${gpsc_shared}/monitor.c"
    "${gpsc_root}/apps/gpu-finite/current-monitor.patch")
  apply_build_patch("${gpsc_build}/return-link.ld" "${gpsc_link}"
    "${gpsc_root}/apps/gpu-finite/link.patch")
  set(gpsc_link "${gpsc_build}/return-link.ld")
  list(REMOVE_ITEM gpsc_sources "${gpsc_shared}/monitor.c")
  list(APPEND gpsc_sources "${gpsc_build}/return-monitor.c" "${gpsc_root}/apps/gpu-finite/finite.c"
    "${gpsc_root}/apps/gpu-finite/exit.c" "${gpsc_root}/apps/gpu-finite/return.c" "${gpsc_root}/apps/gpu-finite/return.S")
endif()
list(REMOVE_DUPLICATES gpsc_sources)
set(gpsc_target sunstone-a733-gpu-compute-single-core)
if(SUNSTONE_GPU_RUNTIME_DRAW)
  set(gpsc_target sunstone-a733-gpu-draw-single-core)
endif()
if(SUNSTONE_GPU_RUNTIME_TEXTURE)
  set(gpsc_target sunstone-a733-gpu-texture-single-core)
endif()
add_executable(${gpsc_target} EXCLUDE_FROM_ALL ${gpsc_sources})
if(SUNSTONE_GPU_RUNTIME_TEXTURE)
  target_link_options(${gpsc_target} PRIVATE -Wl,--defsym=__gpu_texture_session_bytes=632)
endif()
get_target_property(gpsc_options sunstone-a733-gpu-render COMPILE_OPTIONS)
get_target_property(gpsc_includes sunstone-a733-gpu-render INCLUDE_DIRECTORIES)
get_target_property(gpsc_definitions sunstone-a733-gpu-render COMPILE_DEFINITIONS)
list(FILTER gpsc_definitions EXCLUDE REGEX "^SUNSTONE_A733_SMP_DIAGNOSTIC=")
set(gpsc_workload "fixed-arithmetic-repeat")
set(gpsc_manifest_target "${gpsc_target}")
set(gpsc_profile "gpu-single-core-supervised-v2")
if(SUNSTONE_GPU_FINITE_RETURN)
  list(APPEND gpsc_definitions SUNSTONE_GPU_FINITE_RETURN=1)
  set(gpsc_workload "fixed-arithmetic-repeat-return")
  set(gpsc_manifest_target "sunstone-a733-gpu-finite-returning")
  set(gpsc_profile "gpu-single-core-returning-v1")
  target_include_directories(${gpsc_target} PRIVATE "${gpsc_root}/apps/gpu-finite")
  set_property(SOURCE "${gpsc_build}/platform.c" APPEND PROPERTY COMPILE_DEFINITIONS
    "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,${gpsc_target}>:platform_exit=gpu_previous_platform_exit>")
endif()
if(SUNSTONE_GPU_RUNTIME_DRAW)
  if(SUNSTONE_GPU_PROGRAM_APPLICATION OR SUNSTONE_GPU_RUNTIME_INPUT OR SUNSTONE_GPU_TRANSPORT_ONLY)
    message(FATAL_ERROR "Copied draw is a separate GPU application profile")
  endif()
  set(gpsc_workload "copied-triangle-draw")
endif()
if(SUNSTONE_GPU_RUNTIME_TEXTURE)
  set(gpsc_workload "copied-indexed-texture-draw")
endif()
if(SUNSTONE_GPU_PROGRAM_APPLICATION)
  if(SUNSTONE_GPU_TRANSPORT_ONLY OR NOT SUNSTONE_GPU_COMPUTE_APPLICATION OR NOT SUNSTONE_GPU_SUPERVISED)
    message(FATAL_ERROR "GPU program sessions require supervised single-core compute")
  endif()
  list(APPEND gpsc_definitions SUNSTONE_GPU_PROGRAM_APPLICATION=1)
  set(gpsc_workload "trusted-compiled-program")
  target_link_options(${gpsc_target} PRIVATE -Wl,--defsym=__gpu_session_bytes=12288)
endif()
set(gpsc_runtime_input false)
if(SUNSTONE_GPU_RUNTIME_INPUT)
  if(NOT SUNSTONE_GPU_PROGRAM_APPLICATION)
    message(FATAL_ERROR "Runtime input requires the trusted GPU program application")
  endif()
  list(APPEND gpsc_definitions SUNSTONE_GPU_RUNTIME_INPUT=1)
  set(gpsc_runtime_input true)
endif()
if(SUNSTONE_GPU_TRANSPORT_ONLY)
  list(APPEND gpsc_definitions SUNSTONE_GPU_TRANSPORT_ONLY=1)
  set(gpsc_workload "shared-usb-pending")
endif()
if(SUNSTONE_GPU_LIFECYCLE)
  if(NOT SUNSTONE_GPU_SUPERVISED OR SUNSTONE_GPU_TRANSPORT_ONLY OR SUNSTONE_GPU_FINITE_RETURN OR
      (NOT SUNSTONE_GPU_RUNTIME_INPUT AND NOT SUNSTONE_GPU_RUNTIME_DRAW))
    message(FATAL_ERROR "GPU lifecycle requires the exclusive supervised runtime GPU image")
  endif()
  target_sources(${gpsc_target} PRIVATE "${gpsc_root}/platform/a733/gpu_disposal.c")
  list(APPEND gpsc_sources "${gpsc_root}/platform/a733/gpu_disposal.c")
  list(APPEND gpsc_definitions SUNSTONE_GPU_LIFECYCLE=1)
  string(APPEND gpsc_workload "-lifecycle")
endif()
list(FILTER gpsc_includes EXCLUDE REGEX "(a733-smp-cached|freertos-a733-smp-cached)")
set_property(TARGET ${gpsc_target} PROPERTY COMPILE_OPTIONS "${gpsc_options}")
target_include_directories(${gpsc_target} BEFORE PRIVATE "${gpsc_app}" "${gpsc_port}")
target_include_directories(${gpsc_target} PRIVATE ${gpsc_includes})
target_compile_definitions(${gpsc_target} PRIVATE ${gpsc_definitions} GUEST=1 SUNSTONE_CACHED_SINGLE_CORE=1 SUNSTONE_GPU_SINGLE_CORE=1)
# The shared adapter's local boot.h stays unchanged; include the GPU log placement first.
set_property(SOURCE "${gpsc_shared}/monitor.c" "${gpsc_shared}/runtime.c" "${gpsc_build}/platform.c" APPEND PROPERTY COMPILE_OPTIONS
 "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,${gpsc_target}>:-include>"
 "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,${gpsc_target}>:${gpsc_app}/boot.h>")
file(GLOB gpsc_headers "${gpsc_app}/*.h")
# gpsc_sources holds the patched copy of platform.c; its source and patch
# must also re-run configuration when edited.
set(gpsc_inputs ${gpu_app_inputs} ${gpsc_sources} ${gpsc_headers}
 "${gpsc_port}/portmacro.h" "${gpsc_port}/port.c" "${gpsc_shared}/boot.h" "${gpsc_shared}/cached.h"
 "${gpsc_shared}/FreeRTOSConfig.h" "${gpsc_shared}/link.ld" "${gpsc_root}/platform/a733/platform.c"
 "${gpsc_shared}/platform.patch"
 "${gpsc_app}/link.patch" "${CMAKE_CURRENT_LIST_FILE}" "${gpsc_root}/patches/freertos-aarch64-clang.patch")
if(SUNSTONE_GPU_FINITE_RETURN)
  # The patched monitor replaces the shared one in gpsc_sources; its source
  # must still re-run configuration when edited.
  list(APPEND gpsc_inputs "${gpsc_root}/apps/gpu-finite/current-monitor.patch"
    "${gpsc_shared}/monitor.c" "${gpsc_root}/apps/gpu-finite/link.patch" "${gpsc_root}/apps/gpu-finite/return.h"
    "${gpsc_root}/apps/gpu-finite/finite.h" "${gpsc_link}")
endif()
list(REMOVE_DUPLICATES gpsc_inputs)
set(gpsc_identity "gpu-fixed-arithmetic;single-boot-cpu;SRE;supervised60;retained;${gpu_app_cc_hash};${gpu_app_ld_hash};${gpsc_options};${gpsc_definitions};${CMAKE_C_FLAGS};${CMAKE_ASM_FLAGS}")
foreach(input IN LISTS gpsc_inputs)
 file(SHA256 "${input}" gpsc_hash)
 string(APPEND gpsc_identity "${gpsc_hash}")
endforeach()
string(SHA256 gpsc_build_id "${gpsc_identity}")
string(REGEX REPLACE "(..)" "0x\\1," gpsc_id_bytes "${gpsc_build_id}")
file(WRITE "${gpsc_build}/build-id.c.tmp" "const unsigned char a733_smp_build_id[32]={${gpsc_id_bytes}};\n")
configure_file("${gpsc_build}/build-id.c.tmp" "${gpsc_build}/build-id.c" COPYONLY)
file(WRITE "${gpsc_build}/build-id.txt" "${gpsc_build_id}\n")
target_sources(${gpsc_target} PRIVATE "${gpsc_build}/build-id.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${gpsc_inputs})
target_link_options(${gpsc_target} PRIVATE -nostdlib -static -Wl,--gc-sections
 "-Wl,-T,${gpsc_link}" "-Wl,-Map,${gpsc_build}/image.map")
set_target_properties(${gpsc_target} PROPERTIES SUFFIX ".elf" LINK_DEPENDS "${gpsc_link}")
set(gpsc_manifest_script [=[
file(SHA256 "${IMAGE}" digest)
file(WRITE "@gpsc_build@/manifest.json" "{\"target\":\"@gpsc_manifest_target@\",\"execution_profile\":\"@gpsc_profile@\",\"workload\":\"@gpsc_workload@\",\"runtime_input\":@gpsc_runtime_input@,\"build_id\":\"@gpsc_build_id@\",\"final_elf\":\"${digest}\"}\n")
]=])
string(CONFIGURE "${gpsc_manifest_script}" gpsc_manifest_script @ONLY)
file(WRITE "${gpsc_build}/finish-manifest.cmake" "${gpsc_manifest_script}")
add_custom_command(TARGET ${gpsc_target} POST_BUILD
 COMMAND "${CMAKE_COMMAND}" "-DIMAGE=$<TARGET_FILE:${gpsc_target}>" -P "${gpsc_build}/finish-manifest.cmake")
