include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/sunstone-application.cmake")

# Hash source inputs and effective settings of each linked application library.
# Archives supplied by path must exist at configure time; targets contribute
# their source closure, including private headers, before their archive exists.
function(sunstone_application_closure target output_inputs output_settings visited)
  if(target IN_LIST visited)
    set(${output_inputs} "" PARENT_SCOPE)
    set(${output_settings} "" PARENT_SCOPE)
    return()
  endif()
  list(APPEND visited "${target}")
  set(inputs)
  set(settings)
  get_target_property(source_dir ${target} SOURCE_DIR)
  get_target_property(sources ${target} SOURCES)
  if(NOT sources STREQUAL "sources-NOTFOUND")
    foreach(source IN LISTS sources)
      if(NOT source MATCHES "^\\$<")
        get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${source_dir}")
        list(APPEND inputs "${source}")
      endif()
    endforeach()
  endif()
  foreach(property COMPILE_OPTIONS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES COMPILE_FEATURES
      INTERFACE_COMPILE_OPTIONS INTERFACE_COMPILE_DEFINITIONS INTERFACE_INCLUDE_DIRECTORIES)
    get_target_property(value ${target} ${property})
    if(NOT value STREQUAL "value-NOTFOUND")
      sunstone_portable_text(portable "${value}")
      string(APPEND settings ";${target}:${property}=${portable}")
      if(property MATCHES "INCLUDE_DIRECTORIES$")
        foreach(directory IN LISTS value)
          if(NOT directory MATCHES "^\\$<")
            file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${directory}/*.h" "${directory}/*.hpp" "${directory}/*.inc")
            list(APPEND inputs ${headers})
          endif()
        endforeach()
      endif()
    endif()
  endforeach()
  get_target_property(libraries ${target} LINK_LIBRARIES)
  if(NOT libraries STREQUAL "libraries-NOTFOUND")
    foreach(library IN LISTS libraries)
      if(TARGET "${library}")
        sunstone_application_closure("${library}" nested_inputs nested_settings "${visited}")
        list(APPEND inputs ${nested_inputs})
        string(APPEND settings ";${nested_settings}")
      elseif(IS_ABSOLUTE "${library}")
        list(APPEND inputs "${library}")
      endif()
    endforeach()
  endif()
  set(${output_inputs} "${inputs}" PARENT_SCOPE)
  set(${output_settings} "${settings}" PARENT_SCOPE)
endfunction()

function(add_sunstone_image target)
  cmake_parse_arguments(IMAGE "" "LIFETIME;APPLICATION" "SERVICES" ${ARGN})
  if(IMAGE_UNPARSED_ARGUMENTS OR NOT IMAGE_LIFETIME MATCHES "^(supervised|resident|return)$" OR
     (IMAGE_APPLICATION AND NOT TARGET "${IMAGE_APPLICATION}"))
    message(FATAL_ERROR "add_sunstone_image requires LIFETIME and a registered APPLICATION")
  endif()
  if((IMAGE_LIFETIME STREQUAL "resident" AND NOT SUNSTONE_A733_OS_RESIDENT) OR
     (NOT IMAGE_LIFETIME STREQUAL "resident" AND SUNSTONE_A733_OS_RESIDENT))
    message(FATAL_ERROR "Image lifetime differs from the selected OS core profile")
  endif()
  set(selected_services)
  foreach(service radio npu)
    string(TOUPPER "${service}" option)
    if(SUNSTONE_A733_OS_${option})
      list(APPEND selected_services "${service}")
    endif()
  endforeach()
  set(requested_services ${IMAGE_SERVICES})
  list(SORT selected_services)
  list(SORT requested_services)
  if(NOT "${selected_services}" STREQUAL "${requested_services}")
    message(FATAL_ERROR "Image SERVICES must match the selected OS core profile: ${selected_services}")
  endif()
  foreach(service IN LISTS IMAGE_SERVICES)
    if(NOT service MATCHES "^(radio|npu)$")
      message(FATAL_ERROR "Unknown selectable OS service: ${service}")
    endif()
    string(TOUPPER "${service}" option)
    if(NOT SUNSTONE_A733_OS_${option})
      message(FATAL_ERROR "Service ${service} is absent from the selected OS core profile")
    endif()
  endforeach()
  if(IMAGE_APPLICATION)
  get_target_property(directory ${IMAGE_APPLICATION} SUNSTONE_MANIFEST_DIRECTORY)
  get_target_property(name ${IMAGE_APPLICATION} SUNSTONE_APPLICATION_NAME)
  string(REPLACE "-" "_" cname "${name}")
  set(manifest_source "${directory}/${cname}-manifest.c")
  else()
    set(name "")
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/sunstone-applications/none")
    file(MAKE_DIRECTORY "${directory}")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${SUNSTONE_SOURCE_ROOT}/tools/sunstone-manifest.py"
      emit --no-application --output "${directory}" COMMAND_ERROR_IS_FATAL ANY)
    set(manifest_source)
  endif()
  # The session lifetime comes from the application's manifest (tools/session_lifetime.py): startup, setup, run_us and
  # return_reserve_us. An image with no application keeps the header's default. The resident lifetime has no deadline.
  if(IMAGE_APPLICATION AND NOT IMAGE_LIFETIME STREQUAL "resident")
    get_target_property(manifest_json ${IMAGE_APPLICATION} SUNSTONE_MANIFEST)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${SUNSTONE_SOURCE_ROOT}/tools/session_lifetime.py"
      --manifest "${manifest_json}" OUTPUT_VARIABLE session_seconds OUTPUT_STRIP_TRAILING_WHITESPACE
      RESULT_VARIABLE session_status)
    if(NOT session_status EQUAL 0)
      message(FATAL_ERROR "The manifest of ${IMAGE_APPLICATION} needs a session longer than the longest one")
    endif()
    # The core's own sources (session.c, thermal.c, cpu-return.c) and the application and device objects built from the
    # settings must agree on it.
    target_compile_definitions(sunstone-a733-os-core PRIVATE A733_BOARD_SUPERVISED_SECONDS=${session_seconds}u)
    target_compile_definitions(sunstone-os-settings INTERFACE A733_BOARD_SUPERVISED_SECONDS=${session_seconds}u)
    message(STATUS "${target}: session lifetime ${session_seconds} s from the manifest")
    set(image_session_seconds ${session_seconds})
  else()
    set(image_session_seconds 60)
  endif()
  if(target STREQUAL "sunstone-a733-os")
    set(output "${CMAKE_CURRENT_BINARY_DIR}/os-image")
  else()
    set(output "${CMAKE_CURRENT_BINARY_DIR}/os-image/${target}")
  endif()
  file(MAKE_DIRECTORY "${output}")
  add_executable(${target} EXCLUDE_FROM_ALL ${manifest_source}
    "${directory}/sunstone-tables.c")
  get_target_property(devices sunstone-a733-os-core SUNSTONE_DEVICE_OBJECTS)
  target_link_libraries(${target} PRIVATE sunstone-os-settings sunstone-a733-os-core ${devices}
    ${IMAGE_APPLICATION} a733-board-usb2-host)
  set(app_libraries)
  if(IMAGE_APPLICATION)
    get_target_property(app_libraries ${IMAGE_APPLICATION} SUNSTONE_APPLICATION_LIBRARIES)
  endif()
  target_link_libraries(${target} PRIVATE ${app_libraries}
    "${newlib_sysroot}/lib/libstdc++.a" "${newlib_sysroot}/lib/libsupc++.a"
    "${smp_libc}/lib/libm.a" "${smp_libc}/lib/libc.a"
    "${NEWLIB_ROOT}/lib/gcc/aarch64-none-elf/14.3.1/libgcc.a")
  target_include_directories(${target} PRIVATE "${directory}")
  get_target_property(options sunstone-a733-os-core LINK_OPTIONS)
  list(FILTER options EXCLUDE REGEX "Map,|__runtime_heap_size")
  set(heap 0)
  if(IMAGE_APPLICATION)
  get_target_property(manifest_input ${IMAGE_APPLICATION} SUNSTONE_MANIFEST)
  file(READ "${manifest_input}" manifest)
  string(JSON heap ERROR_VARIABLE error GET "${manifest}" cpu heap_bytes)
  if(error)
    set(heap 0)
  endif()
  endif()
  # A heap above the linked limit is a region of the application memory ledger (tools/memory_layout.py): the image
  # then links only the OS's share, and the manifest tool adds the heap as a large region.
  foreach(key heap_base heap_link_max)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${SUNSTONE_SOURCE_ROOT}/tools/memory_layout.py" --get ${key}
      OUTPUT_VARIABLE ${key} OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  endforeach()
  if(heap GREATER heap_link_max)
    if(NOT SUNSTONE_A733_DRAM_DECODE_PROBE)
      message(FATAL_ERROR "A heap of ${heap} bytes comes from upper memory, which needs -DSUNSTONE_A733_DRAM_DECODE_PROBE=ON")
    endif()
    set(heap 0)
  endif()
  math(EXPR heap "${heap} + ${heap_base}")
  target_link_options(${target} PRIVATE ${options} -Wl,--wrap=_impure_ptr
    "-Wl,--defsym=__runtime_heap_size=${heap}" "-Wl,-Map,${output}/image.map")
  get_target_property(link_script sunstone-a733-os-core SUNSTONE_LINK_SCRIPT)
  set_target_properties(${target} PROPERTIES SUFFIX ".elf" LINKER_LANGUAGE CXX LINK_DEPENDS "${link_script}")
  get_target_property(inputs sunstone-a733-os-core SUNSTONE_INPUTS)
  set(app_sources)
  set(app_inputs)
  if(IMAGE_APPLICATION)
  get_target_property(app_sources ${IMAGE_APPLICATION} SOURCES)
  get_target_property(app_source_dir ${IMAGE_APPLICATION} SOURCE_DIR)
  foreach(source IN LISTS app_sources)
    get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${app_source_dir}")
    list(APPEND inputs "${source}")
  endforeach()
  get_target_property(app_inputs ${IMAGE_APPLICATION} SUNSTONE_APPLICATION_INPUTS)
  sunstone_application_closure(${IMAGE_APPLICATION} closure_inputs closure_settings "")
  list(APPEND app_inputs ${closure_inputs})
  list(APPEND app_inputs "${manifest_input}" "${directory}/manifest.json" ${manifest_source} "${directory}/${cname}-app.h")
  endif()
  list(APPEND inputs ${app_inputs} "${directory}/sunstone-tables.c"
    "${SUNSTONE_SOURCE_ROOT}/cmake/sunstone-application.cmake"
    "${SUNSTONE_SOURCE_ROOT}/cmake/sunstone-image.cmake")
  list(REMOVE_DUPLICATES inputs)
  set(identity "sunstone-image-1;${name};${IMAGE_LIFETIME};${IMAGE_SERVICES};${CMAKE_C_COMPILER_ID};${CMAKE_C_COMPILER_VERSION}")
  string(APPEND identity ";${closure_settings}")
  foreach(property COMPILE_OPTIONS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_FEATURES)
    get_target_property(value sunstone-os-settings INTERFACE_${property})
    sunstone_portable_text(value "${value}")
    string(APPEND identity ";${property}=${value}")
  endforeach()
  string(TOUPPER "${CMAKE_BUILD_TYPE}" configuration)
  foreach(language C CXX ASM)
    sunstone_portable_text(flags "${CMAKE_${language}_FLAGS};${CMAKE_${language}_FLAGS_${configuration}}")
    string(APPEND identity ";${language}_FLAGS=${flags}")
  endforeach()
  foreach(library "${newlib_sysroot}/lib/libstdc++.a" "${newlib_sysroot}/lib/libsupc++.a"
      "${smp_libc}/lib/libm.a" "${smp_libc}/lib/libc.a"
      "${NEWLIB_ROOT}/lib/gcc/aarch64-none-elf/14.3.1/libgcc.a")
    list(APPEND inputs "${library}")
  endforeach()
  foreach(input IN LISTS inputs)
    file(SHA256 "${input}" digest)
    string(APPEND identity "${digest}")
  endforeach()
  string(SHA256 build_id "${identity}")
  string(REGEX REPLACE "(..)" "0x\\1," id_bytes "${build_id}")
  file(WRITE "${output}/${target}-build-id.c" "const unsigned char a733_smp_build_id[32]={${id_bytes}};\n")
  file(WRITE "${output}/build-id.txt" "${build_id}\n")
  target_sources(${target} PRIVATE "${output}/${target}-build-id.c")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${inputs})
  set(symbol_arguments)
  if(NOT name)
    set(name none)
  else()
    list(APPEND symbol_arguments --application-objects "$<TARGET_OBJECTS:${IMAGE_APPLICATION}>")
    foreach(library IN LISTS app_libraries)
      if(TARGET "${library}")
        list(APPEND symbol_arguments --application-library "$<TARGET_FILE:${library}>")
      elseif(IS_ABSOLUTE "${library}")
        list(APPEND symbol_arguments --application-library "${library}")
      endif()
    endforeach()
    foreach(library "${newlib_sysroot}/lib/libstdc++.a" "${newlib_sysroot}/lib/libsupc++.a"
        "${smp_libc}/lib/libm.a" "${smp_libc}/lib/libc.a"
        "${NEWLIB_ROOT}/lib/gcc/aarch64-none-elf/14.3.1/libgcc.a")
      list(APPEND symbol_arguments --runtime-library "${library}")
    endforeach()
  endif()
  add_custom_command(TARGET ${target} POST_BUILD
    COMMAND "${Python3_EXECUTABLE}" "${SUNSTONE_SOURCE_ROOT}/checks/sunstone-image-link.py"
      --image "$<TARGET_FILE:${target}>" --manifest "${directory}/manifest.bin"
      --application "${name}" --build-id "${output}/build-id.txt"
      --lifetime "${IMAGE_LIFETIME}" --session-seconds "${image_session_seconds}" --output "${output}/link-check.json"
      --nm "${CMAKE_NM}" ${symbol_arguments}
    COMMAND "${Python3_EXECUTABLE}" "${SUNSTONE_SOURCE_ROOT}/tools/board_readme.py"
      --manifest "${output}/link-check.json" --image "$<TARGET_FILE:${target}>"
      --output "${output}/README.md"
    COMMAND_EXPAND_LISTS VERBATIM)
endfunction()
