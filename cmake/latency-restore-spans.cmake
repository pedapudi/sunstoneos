include_guard(GLOBAL)
option(SUNSTONE_LATENCY_RESTORE_SPANS "Enclose exception mask spans through their final software restore point" OFF)

function(sunstone_enable_latency_restore_spans target)
  if(NOT SUNSTONE_LATENCY_RESTORE_SPANS)
    return()
  endif()
  get_target_property(bound ${target} SUNSTONE_LATENCY_RESTORE_SPANS_BOUND)
  if(bound)
    return()
  endif()
  get_target_property(sources ${target} SOURCES)
  set(original)
  foreach(source IN LISTS sources)
    get_filename_component(name "${source}" NAME)
    if(name STREQUAL "portASM.S")
      if(original)
        message(FATAL_ERROR "${target}: multiple assembly ports for restore-span tracing")
      endif()
      set(original "${source}")
    endif()
  endforeach()
  if(NOT original)
    message(FATAL_ERROR "${target}: restore spans require the final instrumented assembly port")
  endif()
  set(output "${CMAKE_CURRENT_BINARY_DIR}/latency-restore/${target}/portASM.S")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/latency-restore/${target}")
  set(patch "${SUNSTONE_SOURCE_ROOT}/patches/freertos-mask-returns.patch")
  apply_build_patch("${output}" "${original}" "${patch}")
  foreach(property COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FLAGS)
    get_source_file_property(value "${original}" TARGET_DIRECTORY ${target} ${property})
    if(NOT value STREQUAL "NOTFOUND")
      set_source_files_properties("${output}" TARGET_DIRECTORY ${target}
        PROPERTIES ${property} "${value}")
    endif()
  endforeach()
  list(REMOVE_ITEM sources "${original}")
  list(APPEND sources "${output}" "${SUNSTONE_SOURCE_ROOT}/runtime/latency_restore.c")
  set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
  set_property(TARGET ${target} PROPERTY SUNSTONE_LATENCY_RESTORE_SPANS_BOUND ON)
  target_compile_definitions(${target} PRIVATE SUNSTONE_LATENCY_RESTORE_SPANS=1)
  target_link_options(${target} PRIVATE -Wl,--wrap=ss_latency_mask_close)
  set_source_files_properties("${SUNSTONE_SOURCE_ROOT}/runtime/latency_restore.c"
    PROPERTIES COMPILE_OPTIONS -mgeneral-regs-only)
  set(inputs "${original}" "${patch}" "${SUNSTONE_SOURCE_ROOT}/cmake/latency-restore-spans.cmake")
  set_property(TARGET ${target} APPEND PROPERTY SUNSTONE_LATENCY_PORT_INPUTS ${inputs})
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${inputs})
endfunction()
