include_guard(GLOBAL)
option(SUNSTONE_LATENCY "Record maximum kernel and device response times" OFF)
option(SUNSTONE_LATENCY_PMU "Add per-span instruction and cache-refill counts to the latency report (read-only PMU use)" OFF)
set_source_files_properties("${SUNSTONE_SOURCE_ROOT}/runtime/latency.c"
  "${SUNSTONE_SOURCE_ROOT}/runtime/latency_irq.c" PROPERTIES COMPILE_OPTIONS -mgeneral-regs-only)

# Preserve the default generated port, including assertion source line numbers.
# Instrumentation belongs to this target's private port and header copies.
function(sunstone_enable_latency_port target)
  get_target_property(sources ${target} SOURCES)
  get_target_property(source_root ${target} SOURCE_DIR)
  set(port_c)
  set(port_asm)
  foreach(source IN LISTS sources)
    get_filename_component(name "${source}" NAME)
    if(name STREQUAL "port.c")
      if(port_c)
        message(FATAL_ERROR "${target}: multiple FreeRTOS C ports")
      endif()
      get_filename_component(port_c "${source}" ABSOLUTE BASE_DIR "${source_root}")
      set(original_c "${source}")
    elseif(name STREQUAL "portASM.S")
      if(port_asm)
        message(FATAL_ERROR "${target}: multiple FreeRTOS assembly ports")
      endif()
      get_filename_component(port_asm "${source}" ABSOLUTE BASE_DIR "${source_root}")
      set(original_asm "${source}")
    endif()
  endforeach()
  get_target_property(includes ${target} INCLUDE_DIRECTORIES)
  set(port_header)
  foreach(directory IN LISTS includes)
    get_filename_component(directory "${directory}" ABSOLUTE BASE_DIR "${source_root}")
    if(EXISTS "${directory}/portmacro.h")
      set(port_header "${directory}/portmacro.h")
      break()
    endif()
  endforeach()
  if(NOT port_c OR NOT port_asm OR NOT port_header)
    message(FATAL_ERROR "${target}: latency instrumentation needs port.c, portASM.S and portmacro.h")
  endif()
  set(output "${CMAKE_CURRENT_BINARY_DIR}/latency-ports/${target}")
  file(MAKE_DIRECTORY "${output}")
  set(inputs "${port_c}" "${port_asm}" "${port_header}")
  foreach(pair "c|${port_c}|port.c" "asm|${port_asm}|portASM.S" "macro|${port_header}|portmacro.h")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 kind)
    list(GET parts 1 input)
    list(GET parts 2 name)
    set(patch "${SUNSTONE_SOURCE_ROOT}/patches/freertos-latency-${kind}.patch")
    apply_build_patch("${output}/${name}" "${input}" "${patch}")
    list(APPEND inputs "${patch}" "${output}/${name}")
    if(NOT kind STREQUAL "macro")
      # Existing privileged-worker hooks and source-specific compiler flags
      # belong to the selected port even after its filename changes.
      foreach(property COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FLAGS)
        get_source_file_property(value "${input}" TARGET_DIRECTORY ${target} ${property})
        if(NOT value STREQUAL "NOTFOUND")
          set_source_files_properties("${output}/${name}" TARGET_DIRECTORY ${target}
            PROPERTIES ${property} "${value}")
        endif()
      endforeach()
    endif()
  endforeach()
  list(REMOVE_ITEM sources "${original_c}" "${original_asm}")
  list(APPEND sources "${output}/port.c" "${output}/portASM.S")
  set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
  target_include_directories(${target} BEFORE PRIVATE "${output}")
  set_property(TARGET ${target} PROPERTY SUNSTONE_LATENCY_PORT_INPUTS "${inputs}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${inputs})
endfunction()

function(sunstone_enable_latency target)
  target_sources(${target} PRIVATE
    "${SUNSTONE_SOURCE_ROOT}/runtime/latency.c"
    "${SUNSTONE_SOURCE_ROOT}/runtime/latency_irq.c")
  target_compile_definitions(${target} PRIVATE SUNSTONE_LATENCY=1)
  target_link_options(${target} PRIVATE -Wl,--wrap=vApplicationIRQHandler)
endfunction()
