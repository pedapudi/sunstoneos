# A distinct bounded diagnostic image with externally admitted large reservations.
if(NOT DEFINED SUNSTONE_SOURCE_ROOT)
  set(SUNSTONE_SOURCE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}")
endif()
if(NOT TARGET a733-smp-cached-diagnostic)
  include("${SUNSTONE_SOURCE_ROOT}/cmake/a733-smp-cached.cmake")
endif()
set(device_target sunstone-a733-smp-cached-devices)
set(device_root "${SUNSTONE_SOURCE_ROOT}")
set(device_build "${CMAKE_CURRENT_BINARY_DIR}/a733-smp-cached-devices")
file(MAKE_DIRECTORY "${device_build}")
get_target_property(device_sources a733-smp-cached-diagnostic SOURCES)
list(FILTER device_sources EXCLUDE REGEX "/build-id\\.c$")
set(device_extra
  platform/a733/device_memory_layout.c platform/a733/memory_reservations.c
  platform/a733/memory_uncached.c runtime/device_memory_pool.c arch/aarch64/device_memory.c)
list(TRANSFORM device_extra PREPEND "${device_root}/")
list(APPEND device_sources ${device_extra})
set(device_linker "${device_root}/platform/a733-smp-cached/link-devices.ld")
add_executable(${device_target} EXCLUDE_FROM_ALL ${device_sources})
foreach(property IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS)
  get_target_property(value a733-smp-cached-diagnostic ${property})
  set_property(TARGET ${device_target} PROPERTY ${property} "${value}")
endforeach()
target_compile_definitions(${device_target} PRIVATE SUNSTONE_A733_EXTENDED_DEVICE_MEMORY=1)
get_target_property(device_links a733-smp-cached-diagnostic LINK_OPTIONS)
list(FILTER device_links EXCLUDE REGEX "^-Wl,(-T,|-Map,)")
target_link_options(${device_target} PRIVATE ${device_links}
  "-Wl,-T,${device_linker}" "-Wl,-Map,${device_build}/image.map")
set_target_properties(${device_target} PROPERTIES SUFFIX ".elf" LINK_DEPENDS "${device_linker}")

# Hash the reused sources and their resolvable include closure. Compiler resource
# headers and exact compiler/linker binaries are included as toolchain inputs.
get_target_property(device_includes ${device_target} INCLUDE_DIRECTORIES)
execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-resource-dir
  OUTPUT_VARIABLE device_resource OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE resource_status)
if(NOT resource_status EQUAL 0)
  message(FATAL_ERROR "Cannot identify compiler resource headers")
endif()
list(APPEND device_includes "${device_resource}/include")
set_property(GLOBAL PROPERTY SUNSTONE_DEVICE_IDENTITY_INPUTS "")
function(device_identity_add input)
  get_filename_component(input "${input}" ABSOLUTE)
  get_property(known GLOBAL PROPERTY SUNSTONE_DEVICE_IDENTITY_INPUTS)
  if(input IN_LIST known)
    return()
  endif()
  if(NOT EXISTS "${input}")
    message(FATAL_ERROR "Missing device image identity input: ${input}")
  endif()
  set_property(GLOBAL APPEND PROPERTY SUNSTONE_DEVICE_IDENTITY_INPUTS "${input}")
  if(input MATCHES "\\.(c|h|S)$")
    file(STRINGS "${input}" directives REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]")
    get_filename_component(parent "${input}" DIRECTORY)
    foreach(directive IN LISTS directives)
      string(REGEX REPLACE "^[ \t]*#[ \t]*include[ \t]*[<\"]([^>\"]+)[>\"].*$" "\\1" name "${directive}")
      foreach(directory IN ITEMS "${parent}" ${device_includes})
        if(EXISTS "${directory}/${name}")
          device_identity_add("${directory}/${name}")
          break()
        endif()
      endforeach()
    endforeach()
  endif()
endfunction()
foreach(input IN LISTS device_sources)
  device_identity_add("${input}")
endforeach()
foreach(input IN ITEMS "${device_linker}" "${device_root}/cmake/a733-smp-cached-devices.cmake"
    "${device_root}/platform/a733-smp-cached-devices/CMakeLists.txt"
    "${device_root}/cmake/a733-smp-cached.cmake" "${device_root}/cmake/aarch64-clang.cmake"
    "${device_root}/platform/a733/cpu_continue.c"
    "${device_root}/platform/a733-smp-cached/continuation-core.patch"
    "${device_root}/patches/freertos-smp-c.patch" "${device_root}/patches/freertos-a733-smp.patch"
    "${device_root}/patches/freertos-smp-asm.patch" "${device_root}/patches/freertos-smp-macro.patch"
    "${FREERTOS_DIR}/portable/GCC/ARM_CR82/port.c"
    "${FREERTOS_DIR}/portable/GCC/ARM_CR82/portASM.S"
    "${FREERTOS_DIR}/portable/GCC/ARM_CR82/portmacro.h")
  device_identity_add("${input}")
endforeach()
get_property(device_identity_inputs GLOBAL PROPERTY SUNSTONE_DEVICE_IDENTITY_INPUTS)
list(SORT device_identity_inputs)
get_target_property(device_definitions ${device_target} COMPILE_DEFINITIONS)
get_target_property(device_options ${device_target} COMPILE_OPTIONS)
get_target_property(device_link_options ${device_target} LINK_OPTIONS)
file(SHA256 "${CMAKE_C_COMPILER}" device_compiler_hash)
if(DEFINED SUNSTONE_LLD AND EXISTS "${SUNSTONE_LLD}")
  file(SHA256 "${SUNSTONE_LLD}" device_linker_hash)
else()
  message(FATAL_ERROR "The large image requires an explicit linker identity")
endif()
set(device_identity "${device_compiler_hash};${device_linker_hash};${CMAKE_C_COMPILER_TARGET};${CMAKE_BUILD_TYPE};${CMAKE_C_FLAGS};${CMAKE_ASM_FLAGS};${CMAKE_EXE_LINKER_FLAGS};${device_definitions};${device_options};${device_link_options};contract=2;layout=1")
foreach(configuration IN ITEMS DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
  string(APPEND device_identity ";${CMAKE_C_FLAGS_${configuration}};${CMAKE_ASM_FLAGS_${configuration}};${CMAKE_EXE_LINKER_FLAGS_${configuration}}")
endforeach()
set(device_manifest "{}")
string(JSON device_manifest SET "${device_manifest}" target "\"${device_target}\"")
string(JSON device_manifest SET "${device_manifest}" contract_version "2")
string(JSON device_manifest SET "${device_manifest}" execution_profile "\"bounded-device-diagnostic-v2\"")
string(JSON device_manifest SET "${device_manifest}" image_kind "\"runtime\"")
string(JSON device_manifest SET "${device_manifest}" compiler_sha256 "\"${device_compiler_hash}\"")
string(JSON device_manifest SET "${device_manifest}" linker_sha256 "\"${device_linker_hash}\"")
string(JSON device_manifest SET "${device_manifest}" inputs "{}")
foreach(input IN LISTS device_identity_inputs)
  file(SHA256 "${input}" digest)
  string(APPEND device_identity "${digest}")
  string(JSON device_manifest SET "${device_manifest}" inputs "${input}" "\"${digest}\"")
endforeach()
string(SHA256 device_build_id "${device_identity}")
string(JSON device_manifest SET "${device_manifest}" build_id "\"${device_build_id}\"")
string(REGEX REPLACE "(..)" "0x\\1," device_id_bytes "${device_build_id}")
file(WRITE "${device_build}/build-id.c.tmp" "const unsigned char a733_smp_build_id[32]={${device_id_bytes}};\n")
configure_file("${device_build}/build-id.c.tmp" "${device_build}/build-id.c" COPYONLY)
file(WRITE "${device_build}/build-id.txt" "${device_build_id}\n")
file(WRITE "${device_build}/manifest-input.json" "${device_manifest}\n")
target_sources(${device_target} PRIVATE "${device_build}/build-id.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${device_identity_inputs})
file(WRITE "${device_build}/finish-manifest.cmake" "file(SHA256 \"\${IMAGE}\" digest)\nfile(READ \"${device_build}/manifest-input.json\" manifest)\nstring(JSON manifest SET \"\${manifest}\" final_elf \"\\\"\${digest}\\\"\")\nfile(WRITE \"${device_build}/manifest.json\" \"\${manifest}\\n\")\n")
add_custom_command(TARGET ${device_target} POST_BUILD
  COMMAND "${CMAKE_COMMAND}" "-DIMAGE=$<TARGET_FILE:${device_target}>"
    -P "${device_build}/finish-manifest.cmake" VERBATIM)
