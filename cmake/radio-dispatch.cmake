# Include after radio-network.cmake. Native networking always links its real
# receive dispatcher; standalone transport models keep their unowned API.
if(TARGET radio-network-model)
  get_filename_component(dispatch_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
  target_sources(radio-network-model PRIVATE "${dispatch_root}/drivers/net/aic8800_dispatch.c")
  get_target_property(dispatch_sources radio-network-model SOURCES)
  list(FILTER dispatch_sources EXCLUDE REGEX "/checks/radio-network[.]c$")
  add_executable(radio-dispatch-model EXCLUDE_FROM_ALL ${dispatch_sources}
    "${dispatch_root}/checks/aic8800-dispatch.c")
  foreach(property INCLUDE_DIRECTORIES COMPILE_OPTIONS LINK_OPTIONS LINK_DEPENDS COMPILE_DEFINITIONS)
    get_target_property(value radio-network-model ${property})
    set_property(TARGET radio-dispatch-model PROPERTY ${property} "${value}")
  endforeach()
  foreach(source IN LISTS dispatch_sources)
    get_source_file_property(options "${source}" TARGET_DIRECTORY radio-network-model COMPILE_OPTIONS)
    if(NOT options STREQUAL "NOTFOUND")
      set_source_files_properties("${source}" TARGET_DIRECTORY radio-dispatch-model PROPERTIES COMPILE_OPTIONS "${options}")
    endif()
  endforeach()
  get_target_property(dispatch_link_options radio-dispatch-model LINK_OPTIONS)
  list(FILTER dispatch_link_options EXCLUDE REGEX "Map,")
  set_property(TARGET radio-dispatch-model PROPERTY LINK_OPTIONS "${dispatch_link_options}")
  target_link_options(radio-dispatch-model PRIVATE "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/radio-dispatch-model.map")
  set_target_properties(radio-dispatch-model PROPERTIES SUFFIX ".elf")
endif()
