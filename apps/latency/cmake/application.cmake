if(SUNSTONE_APPLICATION STREQUAL "latency-dma")
  set(latency_name latency-dma)
  set(latency_manifest "${CMAKE_CURRENT_LIST_DIR}/../manifest-dma.json")
else()
  set(latency_name latency)
  set(latency_manifest "${CMAKE_CURRENT_LIST_DIR}/../manifest.json")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${latency_manifest}")
file(READ "${latency_manifest}" latency_manifest_json)
if(SUNSTONE_SCHED_LATENCY_TRACE OR SUNSTONE_LATENCY_CONTROL)
  string(JSON latency_manifest_json SET "${latency_manifest_json}" output_limit 131072)
  if(SUNSTONE_LATENCY_CAUSE)
    # The cause report's event section; LATENCY_RESULT_LIMIT in workload.h matches.
    string(JSON latency_manifest_json SET "${latency_manifest_json}" output_limit 147456)
  endif()
  if(SUNSTONE_LATENCY_CONTROL)
    string(JSON latency_manifest_json SET "${latency_manifest_json}" deadlines run_us 15000000)
  endif()
  set(latency_manifest "${CMAKE_CURRENT_BINARY_DIR}/${latency_name}-instrumented-manifest.json")
  file(WRITE "${latency_manifest}" "${latency_manifest_json}\n")
endif()
string(JSON latency_run_us GET "${latency_manifest_json}" deadlines run_us)
add_sunstone_application(${latency_name}
  SOURCES "${CMAKE_CURRENT_LIST_DIR}/../native.c" "${CMAKE_CURRENT_LIST_DIR}/../workload.c"
  MANIFEST "${latency_manifest}"
  INCLUDE_DIRECTORIES "${CMAKE_CURRENT_LIST_DIR}/..")
target_compile_definitions(${latency_name} PRIVATE SUNSTONE_LATENCY=1 SUNSTONE_LATENCY_RUN_US=${latency_run_us})
if(SUNSTONE_LATENCY_CONTROL)
  target_sources(${latency_name} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../control.c")
  target_compile_definitions(${latency_name} PRIVATE SUNSTONE_LATENCY_CONTROL=1
    SUNSTONE_LATENCY_CONTROL_MODE=${SUNSTONE_LATENCY_CONTROL_MODE_ID} INCLUDE_eTaskGetState=1)
  if(SUNSTONE_TICKLESS_IDLE)
    target_compile_definitions(${latency_name} PRIVATE SUNSTONE_OWNER_TICKLESS=1)
  endif()
  if(SUNSTONE_LATENCY_RESTORE_SPANS)
    target_compile_definitions(${latency_name} PRIVATE SUNSTONE_LATENCY_RESTORE_SPANS=1)
  endif()
endif()
if(SUNSTONE_SCHED_LATENCY_TRACE)
  target_compile_definitions(${latency_name} PRIVATE SUNSTONE_SCHED_LATENCY_TRACE=1
    SS_SCHED_TRACE_WAITS=16 SS_SCHED_TRACE_TICKS=512 SS_SCHED_TRACE_HISTORY=16
    INCLUDE_eTaskGetState=1)
  target_include_directories(${latency_name} PRIVATE "${SUNSTONE_SOURCE_ROOT}/kernel/scheduler")
endif()
if(SUNSTONE_LATENCY_PMU)
  target_compile_definitions(${latency_name} PRIVATE SUNSTONE_LATENCY_PMU=1)
endif()
if(SUNSTONE_SCHED_PMU)
  target_compile_definitions(${latency_name} PRIVATE SUNSTONE_SCHED_PMU=1)
endif()
if(SUNSTONE_LATENCY_CAUSE)
  target_sources(${latency_name} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../cause-ping.c")
  target_compile_definitions(${latency_name} PRIVATE SUNSTONE_LATENCY_CAUSE=1
    SUNSTONE_LATENCY_STREAM_MASK=${SUNSTONE_LATENCY_STREAM_MASK}u)
endif()
target_compile_options(${latency_name} PRIVATE "$<$<COMPILE_LANGUAGE:C>:-mgeneral-regs-only>")
if(latency_name STREQUAL "latency-dma")
  target_compile_definitions(${latency_name} PRIVATE SUNSTONE_LATENCY_DMA=1)
endif()
option(SUNSTONE_LATENCY_FORCE_FAILURE "Fail deliberately after the CPU clocks reach their top points" OFF)
if(SUNSTONE_LATENCY_FORCE_FAILURE)
  target_compile_definitions(${latency_name} PRIVATE SUNSTONE_LATENCY_FORCE_FAILURE=1)
endif()
option(SUNSTONE_LATENCY_FORCE_EL0_ABORT "Take a data abort at EL0 after the CPU clocks reach their top points" OFF)
if(SUNSTONE_LATENCY_FORCE_EL0_ABORT)
  target_compile_definitions(${latency_name} PRIVATE SUNSTONE_LATENCY_FORCE_EL0_ABORT=1)
endif()
set(SUNSTONE_LATENCY_TLBI "0" CACHE STRING "Issue a broadcast TLB invalidation on every tick of the measured phases: 0 none, 1 TLBI VAE1IS, 2 TLBI ASIDE1IS, 3 TLBI VMALLE1IS")
if(NOT SUNSTONE_LATENCY_TLBI STREQUAL "0")
  target_compile_definitions(${latency_name} PRIVATE SUNSTONE_LATENCY_TLBI=${SUNSTONE_LATENCY_TLBI})
endif()
