+.Lcrumb:
+    // sunstone_crumb(stage, value) (include/sunstone_crumb.h): LAST and TIME
+    // in RTC words, interrupts masked by the exception, all registers kept.
+    // Stored only under the returning lifetime (the sealed copy).
+    stp x2, x3, [sp, #-16]!
+    adrp x2, os_sealed+OS_SEALED_LIFETIME_OFFSET
+    ldr w2, [x2, :lo12:os_sealed+OS_SEALED_LIFETIME_OFFSET]
+    cmp w2, #OS_LIFETIME_RETURN_WORD
+    b.ne 1f
+    ldp x0, x1, [sp, #16]
+    bfi w1, w0, #16, #16
+    mov x2, #0x07090000
+    str w1, [x2, #0x104]
+    mrs x3, cntpct_el0
+    ubfx x3, x3, #10, #29
+    mrs x0, mpidr_el1
+    ubfx x0, x0, #8, #3
+    orr w3, w3, w0, lsl #29
+    str w3, [x2, #0x10c]
+    dsb sy
+1:  ldp x2, x3, [sp], #16
+    ldp x0, x1, [sp], #16
+    eret
+.Lfail_record:
+    // sunstone_crumb_fail(site, value, caller) (include/sunstone_crumb.h):
+    // the first board failure in the FAULT/ESR/ELR/FAR words, unless a fault
+    // or exit already holds them. x2 is the caller, x1 the value. Stored
+    // under the returning and resident lifetimes (the sealed copy).
+    stp x2, x3, [sp, #-16]!
+    stp x4, x5, [sp, #-16]!
+    adrp x3, os_sealed+OS_SEALED_LIFETIME_OFFSET
+    ldr w3, [x3, :lo12:os_sealed+OS_SEALED_LIFETIME_OFFSET]
+    cmp w3, #OS_LIFETIME_RETURN_WORD
+    b.eq .Lfail_lifetime
+    cmp w3, #OS_LIFETIME_RESIDENT_WORD
+    b.ne 1f
+.Lfail_lifetime:
+    ldp x0, x1, [sp, #32]
+    mov x3, #0x07090000
+    ldr w4, [x3, #0x110]
+    cbnz w4, .Lfail_second
+    str w0, [x3, #0x114]
+    str w2, [x3, #0x118]
+    str w1, [x3, #0x11c]
+    mrs x4, mpidr_el1
+    ubfx x4, x4, #8, #3
+    mrs x5, spsr_el1
+    and w5, w5, #0xf
+    mov w0, #0xfa0b0000       // magic, level 0xb
+    orr w0, w0, w4, lsl #20
+    orr w0, w0, w5, lsl #8
+    dsb sy
+    str w0, [x3, #0x110]
+    dsb sy
+1:  ldp x4, x5, [sp], #16
+    ldp x2, x3, [sp], #16
+    ldp x0, x1, [sp], #16
+    eret
+.Lfail_second:
+    // A device failure after an application failure (the failure return of an application whose NPU, GPU or other device then fails):
+    // the first record names the application, so this later one, the device's, replaces the words and FAULT's level becomes 0xc
+    // (SUNSTONE_CRUMB_FAIL_LEVEL_SECOND). Anything else keeps the first record. x3 = RTC base, w4 = FAULT, x0 = site, x1 = value, x2 = caller.
+    ubfx w5, w4, #16, #4
+    cmp w5, #0xb
+    b.ne 1b
+    ldr w5, [x3, #0x114]
+    ubfx w5, w5, #12, #4
+    cmp w5, #4                // the first record is an application failure (SUNSTONE_CRUMB_FAIL_APPLICATION)
+    b.ne 1b
+    ubfx w5, w0, #12, #4
+    cmp w5, #4
+    b.eq 1b                   // and this one is not
+    str w0, [x3, #0x114]
+    str w2, [x3, #0x118]
+    str w1, [x3, #0x11c]
+    bic w4, w4, #0xf0000
+    orr w4, w4, #0xc0000
+    dsb sy
+    str w4, [x3, #0x110]
+    dsb sy
+    b 1b
+.Lqualification:
+    // The returning lifetime's terminal. In any other lifetime the call is
+    // not one of these and goes on to the kernel's handler.
+    adrp x0, os_sealed+OS_SEALED_LIFETIME_OFFSET
+    ldr w0, [x0, :lo12:os_sealed+OS_SEALED_LIFETIME_OFFSET]
+    cmp w0, #OS_LIFETIME_RETURN_WORD
+    ldp x0, x1, [sp], #16
+    b.ne FreeRTOS_SWI_Handler
+    b a733_qualification_terminal_privileged
 .Lexit:
     ldp x0, x1, [sp], #16
     b a733_smp_exit_privileged
 .Lsync_fault:
+    // Under the returning lifetime (the sealed copy, loaded in x16, which
+    // holds only the exception class here): TPIDR_EL1 holds the core index
+    // again (x16 was saved there). The failure return admits an exception
+    // from an EL0 task that was open to the scheduler and returns the task
+    // to EL0 on a reserved stack (apps/os/cpu-return-el0.S); it returns here
+    // for any other exception. Any other lifetime goes on to the fault record.
+    adrp x16, os_sealed+OS_SEALED_LIFETIME_OFFSET
+    ldr w16, [x16, :lo12:os_sealed+OS_SEALED_LIFETIME_OFFSET]
+    cmp w16, #OS_LIFETIME_RETURN_WORD
+    b.ne .Lsync_fault_record
+    mrs x3, mpidr_el1
+    ubfx x3, x3, #8, #3
+    msr tpidr_el1, x3
+    bl os_cpu_return_el0_try
+.Lsync_fault_record:
 #ifdef SUNSTONE_A733_FAULT_PAGE
     // The vector slot from SPSR_EL1.M: 8 from EL0t, 0 from EL1t (images
     // whose private tasks run on SP_EL0), 4 from EL1h.
