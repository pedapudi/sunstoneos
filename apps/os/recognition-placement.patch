 #include "a733_storage_digest.h"
@@ -23,4 +29,6 @@
 void recognize(void *)
 {
+    /* The adapter owns the selected worker count and their fixed placement. */
+    mimus_parallel_bind();
     /* Board owners establish the selected USB readiness. Hashing is
      * EL0 CPU work; publication in EL3 alone does not authenticate inputs. */
@@ -48,4 +56,16 @@
         started.store(current,std::memory_order_release);
         /* Authenticated above: load once, then reuse the retained engine. */
+#ifdef SUNSTONE_A733_OS_CPU_CLOCK
+        /* Time recognition at the granted operating point: the clock owner
+         * has finished its requests, whatever their result. Its two
+         * inspections and one request each have a 120 ms deadline and the
+         * first CPU sensor reading follows within 25 ms, so one second bounds
+         * the wait; an owner that has not finished by then ends the session. */
+        for(TickType_t waited=0;!os_cpu_clock_ready();++waited){
+            if(waited>=pdMS_TO_TICKS(1000)){platform_puts("ERROR cpu clock owner unfinished\n");failed();}
+            if(!mimus_board_live()){failed();}
+            mimus_board_progress();vTaskDelay(1);
+        }
+#endif
         bool ok=mimus_transcribe_recorded(input,scratch,&stopped,kMimusWarm|kMimusVerified);
         started.store(0,std::memory_order_release);
@@ -66,6 +86,19 @@
 }
 }
+extern "C" int os_thermal_throttled(void);
 extern "C" void mimus_native_checkpoint(void)
-{if(!mimus_board_live())failed();mimus_board_progress();}
+{
+    if(!mimus_board_live())failed();
+    /* One bounded sleep per real checkpoint; a stuck engine or GPU cannot
+     * earn progress by looping here. Every inference task uses this hook. */
+    if(os_thermal_throttled()){
+        vTaskDelay(1);
+        if(!mimus_board_live())failed();
+    }
+    mimus_board_progress();
+}
+/* The engine's parallel ranges on the inference worker count as recognizer
+ * progress (apps/mimus/parallel_runtime.cc). */
+extern "C" void mimus_native_inference_progress(void){mimus_board_progress();}
