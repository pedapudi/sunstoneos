@@ -23,4 +30,6 @@
 void recognize(void *)
 {
+    /* The engine's second worker runs on the pair's other core. */
+    mimus_parallel_bind();
     /* Board owners establish the selected USB readiness. Hashing is
      * EL0 CPU work; publication in EL3 alone does not authenticate inputs. */
@@ -36,4 +45,8 @@
         if(std::memcmp(hash,mimus_asset_sha256[i],32)){failed();}
     }
+    /* Every model hash matched: open the GPU session once, when the engine
+     * declares its exact-sum hook. A pre-queue refusal keeps layers on the
