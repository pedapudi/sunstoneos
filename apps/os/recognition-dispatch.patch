@@ -79,5 +107,14 @@
 {char b[17];static const char h[]="0123456789abcdef";for(unsigned i=0;i<16;++i)b[i]=h[(x>>(60-4*i))&15];b[16]=0;platform_puts(b);}
 extern "C" int mimus_board_start(void)
-{runtime_smp_init();runtime_init();return xTaskCreateStatic(recognize,"mimus-recorded",16384,nullptr,3,stack,&task)!=nullptr;}
+{
+    /* The recognizer shares the recognition core with the GPU worker and
+     * INTID 95, so a completion needs no inter-processor interrupt. */
+    runtime_smp_init();runtime_init();
+    /* Recognition and its inference worker run on the recognition pair. */
+    mimus_parallel_init(A733_SMP_RECOGNITION_CORE,A733_SMP_INFERENCE_CORE);
+    os_recognizer=xTaskCreateStaticAffinitySet(recognize,"mimus-recorded",16384,nullptr,3,stack,&task,
+        UBaseType_t{1}<<OS_RECOGNITION_CORE);
+    return os_recognizer!=nullptr;
+}
 extern "C" unsigned mimus_board_started(void){return started.load(std::memory_order_acquire);}
 extern "C" unsigned mimus_board_generation(void){return generation.load(std::memory_order_acquire);}
