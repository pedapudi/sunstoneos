+        __os_sealed_end = .;
+    } > CODE
+    ASSERT(__os_sealed_end > __os_sealed_start && __os_sealed_end <= ORIGIN(CODE) + LENGTH(CODE),
+           "the sealed session must end inside the read-only CODE block")
